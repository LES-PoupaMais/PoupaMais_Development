# Copie para .env e ajuste só o que precisar. Tudo aqui é opcional: sem .env valem os padrões abaixo.
# O "docker compose" lê o .env sozinho; variável exportada no shell vence o .env.

# --- Código dos outros repositórios ----------------------------------------------------------------
# Caminhos relativos a esta pasta. Para testar uma branch, aponte para a worktree dela:
# FRONT_DIR=../wt/telas-integradas
FRONT_DIR=../PoupaMais_FrontEnd
BACK_DIR=../PoupaMais_BackEnd

# --- Modo dev (npm run dev) --------------------------------------------------------------------------
# Escolhidas para não brigar com o compose do back (5432, 8080, 8025, 1025), com o db-test (5433)
# nem com o "npm run dev" do front (3000).
# App pelo nginx (todas as interfaces)
APP_PORT=8000
# Swagger, Mailpit, Postgres e painel: só em 127.0.0.1
SWAGGER_PORT=8001
MAILPIT_PORT=8002
DB_PORT=5434
PAINEL_PORT=9000
# Abrir pelo celular na mesma rede: IP desta máquina (no WSL: ip -4 addr show eth0).
# ORIGENS_DEV_PERMITIDAS libera o "next dev" para esse endereço; APP_URL vai no link do e-mail de senha.
# ORIGENS_DEV_PERMITIDAS=192.168.0.10
# APP_URL=http://192.168.0.10:8000

# --- Modo "como produção" (npm run prod) ----------------------------------------------------------
# Com PROD_HTTP_PORT=80 e PROD_HTTPS_PORT=443 fica idêntico a um servidor real (se as portas estiverem livres).
PROD_HTTP_PORT=8480
PROD_HTTPS_PORT=8443
PROD_MAILPIT_PORT=8402
# Host do link de e-mail e o único que recebe HSTS (ver README). *.localhost já aponta para esta máquina.
PROD_HOST=poupamais.localhost

# --- Pilha E2E (npm run e2e:up), preparada para a suíte futura do front ------------------------
E2E_API_PORT=8580
E2E_MAILPIT_PORT=8525
E2E_DB_PORT=5435
# Porta em que a suíte vai subir o front (link do e-mail e CORS da API)
E2E_FRONT_PORT=3200

# --- Segredos e banco (dev e "como produção") -----------------------------------------------------
# Padrões só de desenvolvimento. Num servidor de verdade: openssl rand -base64 64
DB_USER=poupamais
DB_PASSWORD=poupamais
JWT_SECRET=troque-este-segredo-de-desenvolvimento-por-um-valor-longo-e-aleatorio
JWT_EXPIRACAO_MIN=480
MAIL_FROM="PoupaMais <nao-responda@poupamais.local>"
